NODE_ENV=development
# REDIS_URL=redis://localhost:6379 # Optional - falls back to simulated redis
ADMIN_CORS=http://localhost:7000,http://localhost:7001,https://docs.medusajs.com
STORE_CORS=http://localhost:8000,https://docs.medusajs.com
AUTH_CORS=http://localhost:7000,http://localhost:7001,https://docs.medusajs.com
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret
DATABASE_URL=postgres://postgres:postgres@localhost:5432/medusa # Make sure this database exist - or change connection string to an online database

MEDUSA_ADMIN_EMAIL=admin@yourmail.com
MEDUSA_ADMIN_PASSWORD=supersecret

STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

SENDGRID_API_KEY=
SENDGRID_FROM=

# MinIO Storage Configuration (Optional - falls back to local storage)
# MINIO_ENDPOINT=your-minio-endpoint
# MINIO_ACCESS_KEY=your-access-key
# MINIO_SECRET_KEY=your-secret-key
# MINIO_BUCKET=custom-bucket-name # Optional - defaults to 'medusa-media'

# Meilisearch Configuration (Optional)
# MEILISEARCH_HOST=your-meilisearch-host # e.g. http://localhost:7700
# MEILISEARCH_MASTER_KEY=your-master-key # Required if MEILISEARCH_ADMIN_KEY is not set
# MEILISEARCH_ADMIN_KEY=your-admin-key # Optional - if not set, will be fetched using master key

# Merchant notification recipients (optional — empty means the e-mail is skipped
# with a logged warning, never a crash). See docs/env-inventory.md.
DEV_NOTIFICATION_EMAIL=
OWNER_NOTIFICATION_EMAIL=

# Balíkovna / Česká pošta B2B fulfilment (optional — while any value is missing
# the provider records fulfilments without calling the carrier).
BALIKOVNA_API_URL=
BALIKOVNA_API_TOKEN=
BALIKOVNA_API_SECRET=
BALIKOVNA_API_CUSTOMER_ID=

# iDoklad invoicing (optional — while client id/secret are missing, no invoices
# are issued and every trigger is a logged no-op). Client id + secret: iDoklad
# app → Nastavení → Aplikace → API → Vygenerovat — these two are enough (the
# legacy token endpoint takes just them; verified 2026-08-14). NEVER put real
# values in this template — it is committed; real values go to backend/.env.
IDOKLAD_CLIENT_ID=131320d1-ed0a-427a-8939-51608a8c334f
IDOKLAD_CLIENT_SECRET=9847dadc-785f-4ac2-b93b-b1c5e2b134db
# IDOKLAD_APPLICATION_ID= # optional future-proofing — app registration on https://developer.idoklad.cz; switches to the newer v2 token endpoint
# IDOKLAD_VAT_PAYER=false # Lucia je neplátce DPH — nechat false/nevyplněné
# IDOKLAD_NUMERIC_SEQUENCE_ID= # optional — pins the číselná řada (ostrá řada až při přepnutí na produkci)
# IDOKLAD_TEST_MODE=true # informational — set while the credentials above belong to a trial/test agenda (iDoklad has no sandbox); the admin widget shows a "Test" badge

# ČNB currency sync (optional) — daily job derives foreign-currency prices
# from CZK via the official ČNB fixing for every currency enabled in
# Nastavení → Store. No key needed; this only pads the conversion (in %)
# against exchange-rate drift between fixings.
# CNB_PRICE_MARKUP_PERCENT=2

# „Otevřít web jako admin" — lišta administrátora na storefrontu.
# STEJNOU hodnotu nastavte i ve storefrontu. Nenastavené = můstek je vypnutý.
# Vygenerujte např.: openssl rand -hex 32
ADMIN_BRIDGE_SECRET=
