    "@tanstack/react-query": "^5.85.0",
    "awilix": "^8.0.1",
    "axios": "^1.11.0",
    "bcryptjs": "^3.0.2",
    "jsonwebtoken": "^9.0.2",
    "medusajs-launch-utils": "^0.0.17",
    "minio": "^8.0.3",
    "ms": "^2.1.3",
    "next": "15.1.11",
    "pg": "^8.13.1",
    "resend": "4.0.1",
    "ulid": "^2.3.0",
    "uuid": "^11.1.0",
    "xml2js": "^0.6.2",
    "zod": "^3.25.76"
