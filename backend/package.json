{
  "name": "medusa-2.0-boilerplate-backend",
  "version": "0.0.2",
  "description": "A Prebaked Medusa 2.0 backend",
  "author": "Rasmus Puls",
  "license": "MIT",
  "keywords": [
    "sqlite",
    "postgres",
    "typescript",
    "ecommerce",
    "headless",
    "medusa"
  ],
  "scripts": {
    "build": "medusa build",
    "db:migrate": "cd .medusa/server && ../../node_modules/.bin/medusa db:migrate --all-or-nothing --execute-safe-links",
    "seed": "medusa exec ./src/scripts/seed.ts",
    "start": "cd .medusa/server && ../../node_modules/.bin/medusa start",
    "dev": "medusa develop",
    "dev:email": "email dev --dir ./src/modules/resend/emails"
  },
  "dependencies": {
    "@medusajs/admin-sdk": "2.18.0",
    "@medusajs/admin-shared": "2.18.0",
    "@medusajs/caching": "2.18.0",
    "@medusajs/cli": "2.18.0",
    "@medusajs/dashboard": "2.18.0",
    "@medusajs/draft-order": "2.18.0",
    "@medusajs/framework": "2.18.0",
    "@medusajs/icons": "2.18.0",
    "@medusajs/js-sdk": "2.18.0",
    "@medusajs/medusa": "2.18.0",
    "@medusajs/notification-sendgrid": "2.18.0",
    "@medusajs/payment-stripe": "2.18.0",
    "@medusajs/types": "2.18.0",
    "@medusajs/ui": "4.2.0",
    "@react-email/components": "^0.0.26",
    "@sanity/client": "^7.8.2",
    "@segment/analytics-node": "^2.3.0",
    "@tanstack/react-query": "5.64.2",
    "axios": "^1.11.0",
    "bcryptjs": "^3.0.2",
    "jsonwebtoken": "^9.0.2",
    "minio": "^8.0.3",
    "ms": "^2.1.3",
    "posthog-node": "5.11.0",
    "react-i18next": "13.5.0",
    "react-router-dom": "6.30.4",
    "resend": "4.0.1",
    "ulid": "^2.3.0",
    "uuid": "^11.1.0",
    "xml2js": "^0.6.2",
    "zod": "4.2.0"
  },
  "devDependencies": {
    "@medusajs/test-utils": "2.18.0",
    "@swc/core": "^1.7.28",
    "@swc/jest": "^0.2.37",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "jest": "^29.7.0",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-email": "^5.2.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2",
    "vite": "5.4.21"
  },
  "packageManager": "pnpm@10.11.1",
  "engines": {
    "node": ">=20 <25",
    "npm": "10.x"
  }
}
