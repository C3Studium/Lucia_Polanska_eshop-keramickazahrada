{
  "name": "medusa-next",
  "version": "1.0.3",
  "private": true,
  "author": "Kasper Fabricius Kristensen <kasper@medusajs.com> & Victor Gerbrands <victor@medusajs.com> (https://www.medusajs.com)",
  "description": "Next.js Starter to be used with Medusa server",
  "keywords": [
    "medusa-storefront"
  ],
  "scripts": {
    "sync:styles": "node scripts/sync-styles.js",
    "watch:styles": "chokidar \"src\" -i \"src/styles/system/**\" -i \"src/styles/globals.scss\" -i \"src/styles/_generated-styles.scss\" -i \"**/node_modules/**\" -i \"**/.next/**\" -c \"node scripts/sync-styles.js --event {event} --path '{path}'\"",
    "dev": "pnpm run sync:styles && concurrently \"pnpm run watch:styles\" \"node scripts/run-next-with-storefront-env.js dev -p 8000\"",
    "build": "pnpm run sync:styles && node scripts/run-next-with-storefront-env.js build",
    "start": "next start --hostname 0.0.0.0",
    "build:next": "node scripts/run-next-with-storefront-env.js build",
    "lint": "next lint",
    "analyze": "ANALYZE=true next build",
    "test-e2e": "playwright test e2e"
  },
  "resolutions": {
    "webpack": "^5"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.7",
    "@hookform/error-message": "^2.0.1",
    "@medusajs/icons": "2.18.0",
    "@medusajs/js-sdk": "2.18.0",
    "@medusajs/ui": "4.2.0",
    "@medusajs/ui-preset": "2.18.0",
    "@paypal/paypal-js": "10.1.0",
    "@paypal/react-paypal-js": "10.3.0",
    "@radix-ui/react-accordion": "^1.2.12",
    "@react-email/components": "0.5.1",
    "@sanity/client": "^7.8.2",
    "@sanity/icons": "^3.7.4",
    "@sanity/image-url": "^1.1.0",
    "@sanity/vision": "^4.4.0",
    "@stripe/react-stripe-js": "5.3.0",
    "@stripe/stripe-js": "8.2.0",
    "@types/uuid": "^10.0.0",
    "axios": "^1.11.0",
    "chokidar-cli": "^3.0.0",
    "concurrently": "^9.2.1",
    "framer-motion": "^12.23.12",
    "glob": "^10.4.5",
    "lenis": "^1.3.8",
    "lodash": "^4.17.21",
    "next": "15.5.21",
    "next-sanity": "^10.0.10",
    "pg": "^8.16.3",
    "playwright": "^1.54.2",
    "qs": "^6.14.0",
    "react": "19.0.5",
    "react-country-flag": "^3.1.0",
    "react-dom": "19.0.5",
    "react-intersection-observer": "^9.16.0",
    "regl": "^2.1.1",
    "resend": "^6.0.1",
    "sanity": "^4.4.0",
    "sass": "^1.90.0",
    "server-only": "^0.0.1",
    "styled-components": "^6.1.19",
    "tailwindcss-radix": "^2.9.0",
    "three": "^0.180.0",
    "uuid": "11.1.0",
    "webpack": "^5.101.1"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@medusajs/types": "2.18.0",
    "@playwright/test": "^1.54.2",
    "@types/lodash": "^4.17.20",
    "@types/node": "^24.2.1",
    "@types/pg": "^8.15.5",
    "@types/react": "19.0.5",
    "@types/react-dom": "19.0.5",
    "@types/three": "^0.180.0",
    "ansi-colors": "^4.1.3",
    "autoprefixer": "^10.4.21",
    "babel-loader": "^8.4.1",
    "@typescript-eslint/parser": "8.65.0",
    "eslint": "^9.13.0",
    "eslint-config-next": "15.5.21",
    "postcss": "^8.5.6",
    "prettier": "^2.8.8",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.2",
    "vite": "5.4.21"
  },
  "packageManager": "pnpm@10.11.1",
  "engines": {
    "node": ">=20 <25"
  }
}
